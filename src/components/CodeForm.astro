---
const { mode="new", code, csrf, error, origin } = Astro.props;
const values = code ?? {name:"",slug:"",destination_url:"https://",foreground:"#8E6500",background:"#FFFFFF",error_correction:"H",version:1};
const action = mode === "new" ? "/codes/new" : `/codes/${values.id}/edit`;
---
<form class="editor-grid" method="post" action={action} x-data={`codeEditor(${JSON.stringify({slug:values.slug,foreground:values.foreground,background:values.background,origin})})`}>
  <input type="hidden" name="csrf" value={csrf}/><input type="hidden" name="idempotency_key" value={crypto.randomUUID()}/><input type="hidden" name="version" value={values.version}/>
  <section class="form-card" aria-labelledby="details-title">
    <div class="section-head"><div><p class="step">01</p><h2 id="details-title">Destination and identity</h2></div><span class="status-dot">Saved securely</span></div>
    {error && <div class="alert error" role="alert">{error}</div>}
    <label>Name <input required maxlength="120" name="name" value={values.name} placeholder="e.g. Summer menu"/></label>
    <label>Dynamic destination URL <input required maxlength="2048" type="url" name="destination" value={values.destination_url} inputmode="url" placeholder="https://wa.me/584120000000"/><small>Change this whenever you want—from WhatsApp to a website or campaign. The printed QR remains valid.</small></label>
    <label>Permanent QR address <span class="input-prefix"><span>{new URL(origin).host}/r/</span><input required minlength="3" maxlength="64" pattern="[a-z0-9-]+" name="slug" value={values.slug} x-model="slug" oninput="this.value=this.value.toLowerCase().replace(/[^a-z0-9-]/g,'-')"/></span><small>This is the address stored inside the printed QR. It stays fixed so the dynamic destination above can change without reprinting.</small></label>
    <div class="section-rule"></div>
    <div class="section-head"><div><p class="step">02</p><h2>Brand styling</h2></div></div>
    <p class="alert">Zimaxx template: gold gradient, rounded locator eyes, softened modules, and a protected center for the logo.</p>
    <div class="color-grid"><label>Dark gold <span class="color-field"><input type="color" name="foreground" value={values.foreground} x-model="foreground"/><output x-text="foreground">{values.foreground}</output></span></label><label>Background <span class="color-field"><input type="color" name="background" value={values.background} x-model="background"/><output x-text="background">{values.background}</output></span></label></div>
    <label>Official logo <input value="Zimaxx symbol · included automatically" disabled/><small>The integrated Zimaxx symbol is used on every QR, with no external file storage required.</small></label>
    <label>Error correction <input value="H · 30%" disabled/><input type="hidden" name="error_correction" value="H"/><small>Fixed at the highest correction level to protect scanning around the center logo.</small></label>
    <div class="form-actions"><a class="button secondary" href="/codes">Cancel</a><button class="button primary" type="submit">{mode === "new" ? "Create code" : "Save changes"}</button></div>
  </section>
  <aside class="preview-card" aria-labelledby="preview-title"><div class="preview-top"><div><p class="eyebrow">Live preview</p><h2 id="preview-title">Ready to scan</h2></div><span class="badge active">Dynamic</span></div><div class="preview-wrap"><img :src="previewUrl" src={`/qr/preview.svg?slug=${encodeURIComponent(values.slug||"preview")}&fg=${values.foreground.slice(1)}&bg=${values.background.slice(1)}&level=H`} alt="Live QR code preview" width="320" height="320"/></div><div class="check" :class="contrast >= 4.5 ? 'pass' : 'warn'"><strong x-text="contrast >= 4.5 ? '✓ Strong contrast' : '⚠ Low contrast'">✓ Strong contrast</strong><span x-text="`Ratio ${contrast.toFixed(1)}:1`"></span></div><dl><div><dt>Encoded URL</dt><dd x-text="`${new URL(origin).host}/r/${slug||'preview'}`"></dd></div><div><dt>Correction</dt><dd>H · 30%</dd></div></dl></aside>
</form>
<script is:inline define:vars={{origin}}>
  window.codeEditor=(initial)=>({ ...initial,
    get previewUrl(){return `/qr/preview.svg?slug=${encodeURIComponent(this.slug||'preview')}&fg=${this.foreground.slice(1)}&bg=${this.background.slice(1)}&level=H`},
    get gradientEnd(){const rgb=[1,3,5].map(i=>parseInt(this.foreground.slice(i,i+2),16)),target=[184,134,11];return '#'+rgb.map((v,i)=>Math.round(v+(target[i]-v)*.25).toString(16).padStart(2,'0')).join('')},
    get contrast(){const lum=(hex)=>{const rgb=[1,3,5].map(i=>parseInt(hex.slice(i,i+2),16)/255).map(v=>v<=.03928?v/12.92:((v+.055)/1.055)**2.4);return .2126*rgb[0]+.7152*rgb[1]+.0722*rgb[2]},b=lum(this.background),ratio=(hex)=>{const a=lum(hex);return (Math.max(a,b)+.05)/(Math.min(a,b)+.05)};return Math.min(ratio(this.foreground),ratio(this.gradientEnd))}
  });
</script>
