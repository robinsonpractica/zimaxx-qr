---
import AppLayout from "../layouts/AppLayout.astro";import{currentIdentity}from"../lib/auth";import{analytics,envFrom}from"../lib/db";
const identity=await currentIdentity(Astro);if(!identity)return Astro.redirect("/login?reason=expired");const rows=await analytics(envFrom(Astro.locals).DB);const today=new Date();const days=Array.from({length:30},(_,i)=>{const d=new Date(today);d.setUTCDate(today.getUTCDate()-29+i);return d.toISOString().slice(0,10)});const grouped=new Map<string,{id:string;name:string;slug:string;counts:Map<string,number>}>();for(const row of rows){if(!grouped.has(row.id))grouped.set(row.id,{id:row.id,name:row.name,slug:row.slug,counts:new Map()});if(row.occurred_date)grouped.get(row.id)!.counts.set(row.occurred_date,Number(row.scans));}const cards=[...grouped.values()].map(c=>{const counts=days.map(d=>c.counts.get(d)||0);return{...c,counts,total30:counts.reduce((a,b)=>a+b,0),total7:counts.slice(-7).reduce((a,b)=>a+b,0),max:Math.max(1,...counts)}});const grand7=cards.reduce((s,c)=>s+c.total7,0),grand30=cards.reduce((s,c)=>s+c.total30,0);
---
<AppLayout title="Analytics" current="analytics" user={identity.user} csrf={identity.session.csrf_token}><section class="page-shell"><div class="page-head"><div><p class="eyebrow">Performance</p><h1>Scan analytics</h1><p class="lede">Daily counts only—no cookies, IP addresses, or precise location.</p></div><span class="privacy-pill">◉ Privacy-minimal</span></div><div class="metric-row"><article><span>Last 7 days</span><strong>{grand7.toLocaleString()}</strong></article><article><span>Last 30 days</span><strong>{grand30.toLocaleString()}</strong></article><article><span>Best placement</span><strong>{[...cards].sort((a,b)=>b.total30-a.total30)[0]?.name??"—"}</strong></article></div>{grand30===0?<div class="empty list-card"><div class="empty-icon">⌁</div><h2>Scans will appear here</h2><p>Share or print an active code. Daily totals show after the first real scan.</p><a class="button primary" href="/codes">View codes</a></div>:<div class="analytics-list">{cards.map(card=><article class="chart-card"><div class="chart-head"><div><h2>{card.name}</h2><a href={`/codes/${card.id}/edit`}>/r/{card.slug}</a></div><div class="chart-totals"><span><b>{card.total7}</b> 7 days</span><span><b>{card.total30}</b> 30 days</span></div></div><div class="bars" role="img" aria-label={`Daily scan chart for ${card.name}, ${card.total30} scans in 30 days`}>{card.counts.map((count,i)=><div class="bar-col" title={`${days[i]}: ${count} scans`}><span class="bar" style={`height:${Math.max(3,count/card.max*100)}%`}></span></div>)}</div><div class="axis"><span>{days[0].slice(5)}</span><span>{days[14].slice(5)}</span><span>Today</span></div></article>)}</div>}</section></AppLayout>
