---
import "../styles/global.css";
import { currentIdentity, login } from "../lib/auth";
let error="";
if(await currentIdentity(Astro)) return Astro.redirect("/codes");
if(Astro.request.method==="POST"){
  const form=await Astro.request.formData(); const email=String(form.get("email")||""); const password=String(form.get("password")||"");
  const identity=await login(Astro,email,password); if(identity) return Astro.redirect("/codes"); error="That email and password did not match an active account.";
}
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="Manage Zimmax dynamic QR destinations and scan analytics."/><link rel="icon" href="/favicon.svg"/><title>Sign in · Zimaxx QR</title></head><body class="auth-body"><main class="auth-shell"><section class="auth-brand"><a class="brand" href="/login" aria-label="Zimaxx QR home"><img class="brand-logo" src="/zimaxx-white.png" alt="Zimaxx Perfumes" width="1450" height="322"/></a><h1>One printed code. Every destination ahead.</h1><p>Keep the QR on the Zimmax van while changing where it leads—from WhatsApp to a campaign page, catalogue, or your next promotion.</p><div class="auth-proof"><span>✓ Dynamic destination</span><span>✓ Print-ready files</span><span>✓ Privacy-minimal scans</span></div></section><section class="auth-card"><p class="eyebrow">Owner access</p><h2>Welcome back</h2><p>Sign in to manage Zimmax codes.</p>{Astro.url.searchParams.get("reason")==="expired"&&<div class="alert" role="status">Your session expired. Sign in again.</div>}{error&&<div class="alert error" role="alert">{error}</div>}<form method="post"><label>Email<input name="email" type="email" required autocomplete="username" value="demo@zimmax.test"/></label><label>Password<input name="password" type="password" required minlength="8" autocomplete="current-password" value="demo1234"/></label><button class="button primary" type="submit">Sign in</button></form><small>Demo: demo@zimmax.test / demo1234</small></section></main></body></html>
