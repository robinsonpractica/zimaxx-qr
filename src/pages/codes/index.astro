---
import AppLayout from "../../layouts/AppLayout.astro";import {currentIdentity} from "../../lib/auth";import {envFrom,listCodes} from "../../lib/db";
const identity=await currentIdentity(Astro);if(!identity)return Astro.redirect("/login?reason=expired");const codes=await listCodes(envFrom(Astro.locals).DB,identity.user.id);const active=codes.filter(c=>c.status==="active");const total=codes.reduce((sum,c)=>sum+Number(c.total_scans),0);const top=[...codes].sort((a,b)=>Number(b.total_scans)-Number(a.total_scans))[0];
---
<AppLayout title="Codes" current="codes" user={identity.user} csrf={identity.session.csrf_token}><section class="page-shell"><div class="page-head"><div><p class="eyebrow">Workspace</p><h1>Your codes</h1><p class="lede">Create once, update the destination whenever the campaign changes.</p></div><a class="button primary" href="/codes/new"><span aria-hidden="true">＋</span> New code</a></div>
<div class="metric-row" aria-label="Code summary"><article><span>Active codes</span><strong>{active.length}</strong></article><article><span>Total scans</span><strong>{total.toLocaleString()}</strong><small>Privacy-friendly events</small></article><article><span>Top placement</span><strong>{top?.name??"—"}</strong><small>{top?`${top.total_scans} scans`:"No scan data yet"}</small></article></div>
<div class="list-card"><div class="list-title"><h2>All codes</h2><label class="search"><span class="sr-only">Search codes</span><input type="search" placeholder="Search codes" x-data @input="document.querySelectorAll('[data-code]').forEach(el=>el.hidden=!el.textContent.toLowerCase().includes($event.target.value.toLowerCase()))"/></label></div>{codes.length===0?<div class="empty"><div class="empty-icon">▦</div><h3>Create your first dynamic code</h3><p>Paste a destination, apply your colors, and download a print-ready file.</p><a class="button primary" href="/codes/new">Create code</a></div>:<div class="code-list">{codes.map(code=><article class="code-row" data-code><div class="qr-mini" style={`--qr:${code.foreground}`} aria-hidden="true">▦</div><div class="code-main"><div class="code-title"><h3>{code.name}</h3><span class:list={["badge",code.status]}>{code.status}</span></div><a href={`/r/${code.slug}`} target="_blank">{Astro.url.host}/r/{code.slug}</a><p title={code.destination_url}>{code.destination_url}</p></div><div class="scan-total"><span>Total scans</span><strong>{Number(code.total_scans).toLocaleString()}</strong></div><div class="actions"><a href={`/codes/${code.id}/edit`}>Edit</a><a href={`/codes/${code.id}/export`}>Download</a><form method="post" action={`/codes/${code.id}/status`} hx-post={`/codes/${code.id}/status`} hx-swap="none" hx-confirm={code.status==="active"?"Disable this code? Scanners will see an off message.":"Reactivate this code?"}><input type="hidden" name="csrf" value={identity.session.csrf_token}/><input type="hidden" name="status" value={code.status==="active"?"disabled":"active"}/><input type="hidden" name="idempotency_key" value={crypto.randomUUID()}/><button type="submit">{code.status==="active"?"Disable":"Enable"}</button></form></div></article>)}</div>}</div></section></AppLayout>
