---
import AppLayout from "../../layouts/AppLayout.astro"; import CodeForm from "../../components/CodeForm.astro"; import { currentIdentity, validCsrf } from "../../lib/auth"; import { createCode, envFrom } from "../../lib/db"; import { effectiveErrorCorrection, normalizeDestination, normalizeHex, normalizeSlug } from "../../lib/domain";
const identity=await currentIdentity(Astro); if(!identity)return Astro.redirect("/login?reason=expired"); let error="";
if(Astro.request.method==="POST") { const form=await Astro.request.formData(); if(!validCsrf(Astro.request,identity.session,form))return new Response("Forbidden",{status:403}); try{const env=envFrom(Astro.locals);const id=await createCode(env.DB,{ownerId:identity.user.id,name:String(form.get("name")||"").trim(),slug:normalizeSlug(String(form.get("slug")||"")),destination:normalizeDestination(String(form.get("destination")||""),Astro.url.origin),foreground:normalizeHex(String(form.get("foreground")||"")),background:normalizeHex(String(form.get("background")||"")),errorCorrection:effectiveErrorCorrection(String(form.get("error_correction")||"H"),true),idempotencyKey:String(form.get("idempotency_key")||crypto.randomUUID())});return Astro.redirect(`/codes/${id}/export?created=1`,303);}catch(e){error=e instanceof Error?e.message:"Could not create the code. Try again.";}}
---
<AppLayout title="New code" current="codes" user={identity.user} csrf={identity.session.csrf_token}><section class="page-shell"><div class="page-head compact"><div><a class="back" href="/codes">← All codes</a><h1>Create a code</h1><p class="lede">The short link is permanent. Everything behind it stays editable.</p></div></div><CodeForm csrf={identity.session.csrf_token} error={error} origin={Astro.url.origin}/></section></AppLayout>
