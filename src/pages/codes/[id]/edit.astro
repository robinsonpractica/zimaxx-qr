---
import AppLayout from "../../../layouts/AppLayout.astro"; import CodeForm from "../../../components/CodeForm.astro"; import { currentIdentity, validCsrf } from "../../../lib/auth"; import { envFrom, getCode, updateCode } from "../../../lib/db"; import { effectiveErrorCorrection, normalizeDestination, normalizeHex } from "../../../lib/domain";import{validateLogoPng}from"../../../lib/qr";
const identity=await currentIdentity(Astro);if(!identity)return Astro.redirect("/login?reason=expired");const env=envFrom(Astro.locals),db=env.DB;let code=await getCode(db,identity.user.id,Astro.params.id!);if(!code)return new Response("Code not found",{status:404});let error="";
if(Astro.request.method==="POST"){const form=await Astro.request.formData();if(!validCsrf(Astro.request,identity.session,form))return new Response("Forbidden",{status:403});let newLogoKey:string|undefined;try{const logo=form.get("logo");let logoType:string|undefined;if(logo instanceof File&&logo.size){if(logo.size>1024*1024||logo.type!=="image/png")throw new Error("Logo must be a PNG no larger than 1 MB.");const bytes=new Uint8Array(await logo.arrayBuffer());validateLogoPng(bytes);newLogoKey=`logos/${identity.user.id}/${crypto.randomUUID()}.png`;logoType=logo.type;await env.LOGOS.put(newLogoKey,bytes,{httpMetadata:{contentType:logo.type}});}await updateCode(db,code,{ownerId:identity.user.id,name:String(form.get("name")||"").trim(),destination:normalizeDestination(String(form.get("destination")||""),Astro.url.origin),foreground:normalizeHex(String(form.get("foreground")||"")),background:normalizeHex(String(form.get("background")||"")),errorCorrection:effectiveErrorCorrection(String(form.get("error_correction")||"M"),!!(newLogoKey||code.logo_key)),expectedVersion:Number(form.get("version")),idempotencyKey:String(form.get("idempotency_key")||crypto.randomUUID()),logoKey:newLogoKey,logoType});if(newLogoKey&&code.logo_key)await env.LOGOS.delete(code.logo_key);return Astro.redirect(`/codes/${code.id}/edit?saved=1`,303);}catch(e){if(newLogoKey)await env.LOGOS.delete(newLogoKey);error=e instanceof Error?e.message:"Could not save changes.";}code=(await getCode(db,identity.user.id,code.id))??code;}
---
<AppLayout title={`Edit ${code.name}`} current="codes" user={identity.user} csrf={identity.session.csrf_token}><section class="page-shell"><div class="page-head compact"><div><a class="back" href="/codes">← All codes</a><h1>Edit {code.name}</h1><p class="lede">Changes to the destination take effect on the very next scan.</p></div><a class="button secondary" href={`/codes/${code.id}/export`}>Export</a></div>{Astro.url.searchParams.get("saved")&&<div class="toast" role="status">✓ Changes saved. Future scans use the new destination.</div>}<CodeForm mode="edit" code={code} csrf={identity.session.csrf_token} error={error} origin={Astro.url.origin}/></section></AppLayout>
