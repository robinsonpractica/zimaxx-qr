---
import AppLayout from "../../../layouts/AppLayout.astro"; import CodeForm from "../../../components/CodeForm.astro"; import { currentIdentity, validCsrf } from "../../../lib/auth"; import { envFrom, getCode, updateCode } from "../../../lib/db"; import { effectiveErrorCorrection, normalizeDestination, normalizeHex } from "../../../lib/domain";
const identity=await currentIdentity(Astro);if(!identity)return Astro.redirect("/login?reason=expired");const env=envFrom(Astro.locals),db=env.DB;let code=await getCode(db,Astro.params.id!);if(!code)return new Response("Code not found",{status:404});let error="";
if(Astro.request.method==="POST"){const form=await Astro.request.formData();if(!validCsrf(Astro.request,identity.session,form))return new Response("Forbidden",{status:403});try{await updateCode(db,code,{actorId:identity.user.id,name:String(form.get("name")||"").trim(),destination:normalizeDestination(String(form.get("destination")||""),Astro.url.origin),foreground:normalizeHex(String(form.get("foreground")||"")),background:normalizeHex(String(form.get("background")||"")),errorCorrection:effectiveErrorCorrection(String(form.get("error_correction")||"H"),true),expectedVersion:Number(form.get("version")),idempotencyKey:String(form.get("idempotency_key")||crypto.randomUUID())});return Astro.redirect(`/codes/${code.id}/edit?saved=1`,303);}catch(e){error=e instanceof Error?e.message:"Could not save changes.";}code=(await getCode(db,code.id))??code;}
---
<AppLayout title={`Edit ${code.name}`} current="codes" user={identity.user} csrf={identity.session.csrf_token}><section class="page-shell"><div class="page-head compact"><div><a class="back" href="/codes">← All codes</a><h1>Edit {code.name}</h1><p class="lede">Changes to the destination take effect on the very next scan.</p></div><a class="button secondary" href={`/codes/${code.id}/export`}>Export</a></div>{Astro.url.searchParams.get("saved")&&<div class="toast" role="status">✓ Changes saved. Future scans use the new destination.</div>}<CodeForm mode="edit" code={code} csrf={identity.session.csrf_token} error={error} origin={Astro.url.origin}/></section></AppLayout>
