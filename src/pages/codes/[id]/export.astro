---
import AppLayout from "../../../layouts/AppLayout.astro";import{currentIdentity}from"../../../lib/auth";import{envFrom,getCode}from"../../../lib/db";import{qrSvg}from"../../../lib/qr";
const identity=await currentIdentity(Astro);if(!identity)return Astro.redirect("/login?reason=expired");const env=envFrom(Astro.locals);const code=await getCode(env.DB,Astro.params.id!);if(!code)return new Response("Code not found",{status:404});const encoded=`${env.PUBLIC_APP_ORIGIN||Astro.url.origin}/r/${code.slug}`;const generated=await qrSvg(encoded,{foreground:code.foreground,background:code.background,errorCorrection:code.error_correction},720);
---
<AppLayout title={`Export ${code.name}`} current="codes" user={identity.user} csrf={identity.session.csrf_token}><section class="page-shell"><div class="page-head compact"><div><a class="back" href={`/codes/${code.id}/edit`}>← Edit code</a><h1>Export {code.name}</h1><p class="lede">Download a print-ready file after confirming the scan check.</p></div></div>{Astro.url.searchParams.get("created")&&<div class="toast" role="status">✓ Code created. Its destination remains editable after printing.</div>}<div class="export-grid"><section class="export-preview"><div class="paper" set:html={generated.svg}></div><p class="short-url">{encoded}</p></section><section class="export-options"><div class:list={["scan-result",generated.check.passed?"pass":"warn"]}><span class="result-icon">{generated.check.passed?"✓":"!"}</span><div><h2>{generated.check.passed?"Scannability check passed":"Improve contrast before printing"}</h2><p>{generated.check.message} Contrast ratio {generated.check.ratio.toFixed(1)}:1; correction {generated.level}.</p></div></div><article class="download-card"><div><span class="file-tag">PNG</span><h3>High-resolution raster</h3><p>Best for print shops and design tools that request pixels.</p></div><div class="size-links"><a class="button secondary" href={`/codes/${code.id}/download/png?size=1024`}>1024 px</a><a class="button primary" href={`/codes/${code.id}/download/png?size=2048`}>2048 px</a></div></article><article class="download-card"><div><span class="file-tag">SVG</span><h3>Resolution-independent vector</h3><p>Best for vehicle wraps, packaging, and large-format printing.</p></div><div class="size-links"><a class="button primary" href={`/codes/${code.id}/download/svg?size=2048`}>Download SVG</a></div></article><div class="print-note"><strong>Before sending to print</strong><ul><li>Keep the white quiet zone around all four sides.</li><li>Test at the final physical size and expected viewing distance.</li><li>Do not stretch, crop, or place artwork over the code.</li></ul></div></section></div></section></AppLayout>
